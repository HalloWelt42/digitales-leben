---
// Wortmarke der Seite: Symbol und Name in Festbreitenschrift
import { pfad } from "../lib/pfad";
---

<a class="marke" href={pfad("/")} aria-label="KI-Wissen, zur Startseite">
  <svg viewBox="0 0 512 512" aria-hidden="true">
    <rect x="132" y="262" width="60" height="122" rx="8" class="balken" />
    <rect x="226" y="186" width="60" height="198" rx="8" class="balken" />
    <rect x="320" y="226" width="60" height="158" rx="8" class="balken" />
    <rect x="108" y="384" width="296" height="18" rx="9" class="grundlinie" />
    <circle cx="350" cy="136" r="34" class="punkt" />
  </svg>
  <span>ki<span class="leise">-wissen</span></span>
</a>

<style>
  .marke {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-stark);
    font-family: var(--schrift-mono);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  svg {
    width: 1.9rem;
    height: 1.9rem;
    margin: -0.2rem -0.15rem;
  }

  .balken { fill: var(--akzent); }
  .grundlinie { fill: var(--text); }
  .punkt { fill: var(--knopf); }

  .leise {
    color: var(--text-leise);
    font-weight: 500;
  }
</style>
